*.xcuserstate
DerivedData/
xcuserdata/
*.swiftpm/
.*/

# ---- IDE: CLion / JetBrains ----
.idea/
*.iml

# ---- IDE: QtCreator ----
*.pro.user
*.pro.user.*
*.qbs.user
*.qbs.user.*
*.autosave
*.qmlproject.user
*.qmlproject.user.*
CMakeLists.txt.user*
*creator.user*
/.qmake.cache
/.qmake.stash

