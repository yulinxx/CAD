moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*.qm
*.qmlc
*.jsc
*.prl
*.qmlls.ini
*_qmlcache.qrc
*_plugin_import.cpp
object_script.*.Release
object_script.*.Debug
target_wrapper.*

# ---- Protobuf 生成文件 ----
Generated/
*.pb.cc
*.pb.h
*_pb2.py

# ---- Python ----
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.eggs/
Python/venv/
Python/.venv/
venv/
.venv/
.pytest_cache/
.coverage
htmlcov/
.tox/

# ---- vcpkg ----
vcpkg_installed/

# ---- OS 系统临时文件 ----
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.lnk
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
# Linux
*~
.directory
.Trash-*

# ---- 临时 / 日志 / 备份文件 ----
*.tmp
*.temp
*.swp
*.swo
*.bak
*.orig
*.log
*.old

# ---- 项目特定目录 ----
SVGnest/
Archive/
RenderEngine/
scripts/
# Tools/ 下绝大多数是本地脚本与一次性原型，不入库；但两个性能基准是长期资产，
# 必须入库（它们是"优化前后可比"的唯一依据）。因此改为排除目录内容后按需放行——
# 注意不能写成 「Tools/ + !Tools/xxx/」：父目录被整体排除时，子目录的负向规则无效。
Tools/*
!Tools/PerfBenchmark/
!Tools/RenderBenchmark/
# [A7 修复] .github/ 工作流必须入库，删除此忽略规则

# ---- 测试运行产生的落地文件 ----
# Tesseract/Leptonica 在 CWD 写的二值化调试图，跑 OCR 相关测试就会出现
thresholds_new.pnm

# ---- 凭证 / 密钥 ----
*.pem
*.key
*.p12
*.pfx
.env
.env.local
.comate/plugins/软件开发团队/agents/qa-engineer.md
