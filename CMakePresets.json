{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 3,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default Config",
      "description": "Default build configuration",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "tests-all",
      "displayName": "All Tests Enabled",
      "description": "Enable all module tests through the single BUILD_TESTS switch",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "ci-windows",
      "displayName": "CI Windows",
      "description": "CI configuration for Windows",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON",
        "BUILD_HARDWARE": "OFF",
        "BUILD_VISION": "OFF",
        "BUILD_ENGRAVING": "OFF",
        "BUILD_GEOMODELCORE": "OFF",
        "BUILD_PYTHON": "OFF",
        "APR_PYBIND_CORE": "OFF"
      }
    },
    {
      "name": "ci-macos",
      "displayName": "CI macOS",
      "description": "CI configuration for macOS",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON",
        "BUILD_HARDWARE": "OFF",
        "BUILD_VISION": "OFF",
        "BUILD_ENGRAVING": "OFF",
        "BUILD_GEOMODELCORE": "OFF",
        "BUILD_PYTHON": "OFF",
        "APR_PYBIND_CORE": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "tests-all",
      "configurePreset": "tests-all",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "tests-all",
      "configurePreset": "tests-all",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 4,
        "noTestsAction": "error"
      }
    }
  ]
}
