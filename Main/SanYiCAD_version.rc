        BEGIN
            VALUE "CompanyName", "SanYi Technology"
            VALUE "FileDescription", "SanYi CAD Application"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "SanYiCAD"
            VALUE "LegalCopyright", "Copyright (C) 2026 SanYi Technology. All rights reserved."
            VALUE "OriginalFilename", "SanYiCAD.exe"
            VALUE "ProductName", "SanYi CAD"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
