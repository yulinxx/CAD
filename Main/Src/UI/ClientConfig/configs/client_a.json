{
  "meta": {
    "clientId": "client_a",
    "clientName": "客户 A 精简版",
    "version": "1.1"
  },
  "extends": "base",
  "menus": [
    {
      "id": "algorithm",
      "label": "Algorithm",
      "visible": true,
      "workbenches": ["2D"],
      "items": [
        { "type": "action", "id": "tool.measure", "label": "Measure", "command": "2d.measure", "icon": ":/ui/common/Icons/Actions/measure.svg", "workbenches": ["2D"] }
      ]
    },
    {
      "id": "tools",
      "label": "Tools",
      "visible": true,
      "workbenches": ["2D"],
      "items": [
        { "type": "submenu", "id": "tools.theme", "label": "Theme", "workbenches": ["2D", "3D"], "items": [
          { "type": "action", "id": "theme.system", "label": "System", "command": "theme.system", "workbenches": ["2D", "3D"] },
          { "type": "action", "id": "theme.light", "label": "Light", "command": "theme.light", "workbenches": ["2D", "3D"] },
          { "type": "action", "id": "theme.dark", "label": "Dark", "command": "theme.dark", "workbenches": ["2D", "3D"] }
        ] }
      ]
    },
    {
      "id": "help",
      "label": "Help",
      "visible": true,
      "workbenches": ["2D", "3D"],
      "items": [
        { "type": "action", "id": "help.docs", "label": "Documentation", "command": "help.docs", "workbenches": ["2D", "3D"] },
        { "type": "action", "id": "help.about", "label": "About", "command": "help.about", "workbenches": ["2D", "3D"] }
      ]
    }
  ],
  "toolbars": [
    {
      "id": "DrawToolBar",
      "title": "Draw Tools",
      "position": "left",
      "workbench": "2D",
      "items": []
    }
  ],
  "docks": [
    {
      "id": "SceneDock",
      "title": "Scene",
      "position": "left",
      "widgetType": "SceneTreePanel",
      "visible": true
    }
  ],
  "shortcuts": [
    { "command": "edit.redo", "keys": "Ctrl+Y" }
  ]
}
