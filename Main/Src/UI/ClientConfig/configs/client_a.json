{
  "meta": {
    "clientId": "client_a",
    "clientName": "客户A精简版",
    "version": "2.0",
    "extends": "base"
  },
  "menus": [
    {
      "id": "tools",
      "label": "Tools",
      "workbenches": ["2D", "3D"],
      "items": [
        { "type": "submenu", "id": "tools.algorithm", "label": "Algorithm", "icon": ":/ui/common/Icons/Actions/algo_fill.svg", "workbenches": ["2D", "3D"], "items": [
          { "type": "action", "id": "algo.fill", "label": "Fill", "command": "algo.fill", "icon": ":/ui/common/Icons/Actions/algo_fill.svg", "workbenches": ["2D"] },
          { "type": "action", "id": "algo.relief_engraving", "label": "Relief Engraving", "command": "algo.relief_engraving", "icon": ":/ui/common/Icons/Actions/algo_relief.svg", "workbenches": ["2D", "3D"] }
        ] },
        { "type": "submenu", "id": "tools.measure", "label": "Measure", "icon": ":/ui/common/Icons/Actions/measure.svg", "workbenches": ["2D"], "items": [
          { "type": "action", "id": "tool.measure", "label": "Measure", "command": "tool.measure", "icon": ":/ui/common/Icons/Actions/measure.svg", "workbenches": ["2D"] }
        ] },
        { "type": "submenu", "id": "tools.theme", "label": "Theme", "icon": ":/ui/common/Icons/Help/theme.svg", "workbenches": ["2D", "3D"], "items": [
          { "type": "action", "id": "theme.light", "label": "Light", "command": "theme.light", "checkable": true, "workbenches": ["2D", "3D"] },
          { "type": "action", "id": "theme.dark", "label": "Dark", "command": "theme.dark", "checkable": true, "workbenches": ["2D", "3D"] }
        ] }
      ]
    }
  ],
  "toolbars": [
    {
      "id": "DrawToolBar",
      "title": "Draw Tools",
      "position": "left",
      "workbench": "2D",
      "items": [
        { "type": "action", "id": "tool.select", "label": "Select", "command": "tool.select", "icon": ":/ui/common/Icons/Tools/select.svg" },
        { "type": "action", "id": "tool.line", "label": "Line", "command": "tool.line", "icon": ":/ui/common/Icons/Tools/line.svg" },
        { "type": "action", "id": "tool.rectangle", "label": "Rectangle", "command": "tool.rectangle", "icon": ":/ui/common/Icons/Tools/rectangle.svg" }
      ]
    }
  ],
  "shortcuts": [
    { "command": "edit.undo", "keys": "Ctrl+Z" },
    { "command": "edit.redo", "keys": "Ctrl+Y" },
    { "command": "edit.delete", "keys": "Delete" },
    { "command": "tool.select", "keys": "Esc" }
  ]
}
