    {
      "id": "TopToolBar",
      "title": "Top Tools",
      "position": "top",
      "workbench": "global",
      "items": []
    },
    {
      "id": "RightToolBar",
      "title": "Right Tools",
      "position": "right",
      "workbench": "global",
      "items": []
    }
  ],
  "docks": [
    {
      "id": "SceneDock",
      "title": "Scene",
      "position": "left",
      "widgetType": "SceneTreePanel",
      "visible": true
    },
    {
      "id": "PropertiesDock",
      "title": "Properties",
      "position": "right",
      "widgetType": "PropertiesPanel",
      "visible": true
    }
