{
    "version": 1,
    "defaultPreset": "blender",
    "actions": {
        "select": { "display": "Select", "statusShort": "LMB=Select" },
        "rotate": { "display": "Rotate View", "statusShort": "MMB=Rotate" },
        "pan": { "display": "Pan View", "statusShort": "Shift+MMB=Pan" },
        "zoomDrag": { "display": "Zoom", "statusShort": "Ctrl+MMB=Zoom" },
        "zoom": { "display": "Zoom", "statusShort": "Wheel=Zoom" },
        "menu": { "display": "Context Menu", "statusShort": "RMB=Menu" },
        "fly": { "display": "Fly Move", "statusShort": "WASD/QE=Move" }
    },
    "presets": [
        {
            "id": "blender",
            "display": "Blender",
            "controller": "orbit",
            "rotateScale": 1.0,
            "bindings": [
                { "action": "rotate", "button": "Middle" },
                { "action": "pan", "button": "Middle", "modifiers": ["Shift"] },
                { "action": "zoomDrag", "button": "Middle", "modifiers": ["Ctrl"] },
                { "action": "rotate", "button": "Right", "modifiers": ["Shift"] }
            ],
            "hints": ["select", "rotate", "pan", "zoomDrag", "zoom", "menu"]
        },
        {
            "id": "maya",
            "display": "Maya",
            "controller": "orbit",
            "rotateScale": 1.0,
