                { "action": "rotate", "button": "Left", "modifiers": ["Alt"] },
                { "action": "pan", "button": "Middle" },
                { "action": "zoomDrag", "button": "Right" }
            ],
            "hints": ["select", "rotate", "pan", "zoomDrag", "zoom"]
        },
