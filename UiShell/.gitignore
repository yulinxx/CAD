# ============================================================
# 构建输出
# CMakePresets 的 binaryDir 为 build/<presetName>（customer-a / customer-b / customer-c）
# ============================================================
/build*/
/out/
/install/

# 本树 build/ 下实际用过的构建目录名与截图导出目录；
# 一旦直接在源码根用这些名字配置/导出，同样不该入库。
/vs20*/
/manual-vs-*/
/msui-*/
/customer_[abc]/
/verifyShots/
/.cmake/
_deps/
*_autogen/

# 在源码树内直接配置时产生的 CMake 产物
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
Testing/
compile_commands.json
*.cmake.stamp
*.dir/
Makefile
*.ninja
.ninja_*
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.vcproj
*.vcproj.user

# 本机私有配置（团队共享的是 CMakePresets.json 与 CMakeUserPresets.json.example）
CMakeUserPresets.json

