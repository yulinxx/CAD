/* Slate: light base + neutral slate accents (M5 six-theme parity). */

QWidget {
    background-color: #e9eef3;
    color: #1e293b;
}

QMainWindow {
    background-color: #e9eef3;
}

QMenuBar {
    background-color: #f8fafc;
    border-bottom: 1px solid #cbd5e1;
}

QMenuBar::item:selected {
    background-color: #cbd5e1;
    color: #0f172a;
}

QFrame[msuiRole="panel"] {
    background-color: #f8fafc;
}

QToolBar[msuiRole="toolbar"] {
    background-color: #dce3ea;
    border-bottom: 1px solid #cbd5e1;
}

QStatusBar {
    background-color: #dce3ea;
}
